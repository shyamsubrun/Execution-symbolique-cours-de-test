				input Abort;
				guard (z_4 >= 5);
			}
			transition tr_FAILout_Abort --> FAIL_out_ec_5_6_Abort {
				tguard ((z_4 == clk) && (clk < TM));
				input Abort;
				guard (z_4 < 5);
			}
