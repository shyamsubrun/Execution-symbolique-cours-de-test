digraph symbex_graph {
EC0 [
	label="ec_0< ev:1 , h:0 , w:1 >
atm_syst:Idle

$time = 0
	z = 0
	_clock_index_ = 0
	cl = 0
	wtb = 5
	threshold = 10
	amount = 0
	x = 0
	auth_ok = false
	"
	color=lightblue
	shape=ellipse
	style=filled
]
EC0 -> EC1 [
	label=""
]
EC1 [
	label="ec_1< ev:2 , h:1 , w:1 >
atm_syst:Idle"
	color=lawngreen
	shape=tripleoctagon
	style=filled
]
EC1 -> EC2 [
	label="fired atm_syst.t_init
	INPUT atm_SM:Init
	"
]
EC1 -> EC38 [
	label="output atm_syst:Quiescence
	"
]
EC2 [
	label="ec_2< ev:3 , h:2 , w:1 >
atm_syst:Ready

$time = z_1
	z = z_1
	cl = z_1
	
tpid#1->Idle.t_init"
	color=lawngreen
	shape=tripleoctagon
	style=filled
]
EC2 -> EC3 [
	label="fired atm_syst.t_receive
	INPUT atm_SM:Wdrl( x_2 )
	"
]
EC2 -> EC39 [
	label="output atm_syst:Quiescence
	"
]
EC38 [
	label="ec_38< ev:0 , h:2 , w:1 >
atm_syst:Idle

$time = z_1
	z = z_1
	
QUIESCENCE"
	color=lightblue
	shape=ellipse
	style=filled
]
EC3 [
	label="ec_3< ev:4 , h:3 , w:1 >
atm_syst:Decision

$time = (z_1 + z_2)
	z = z_2
	cl = (z_1 + z_2)
	x = x_2
	
tpid#2->Ready.t_receive\nDEAD_BRANCH_PRUNED\nEC< Id:4 PE:4 H:4 W:1 Q:0 > pid_4:Ready"
	color=lawngreen
	shape=tripleoctagon
	style=filled
]
EC3 -> EC5 [
	label="fired atm_syst.t_valid
	OUTPUT atm_SM:Debit( $_1 )
	"
]
EC3 -> EC40 [
	label="output atm_syst:Quiescence
	"
]
EC39 [
	label="ec_39< ev:0 , h:3 , w:1 >
atm_syst:Ready

$time = (z_1 + z_2)
	z = z_2
	
QUIESCENCE"
	color=lightblue
	shape=ellipse
	style=filled
]
EC5 [
	label="ec_5< ev:5 , h:4 , w:2 >
atm_syst:WaitingAuth

PC: (($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3)
	z = z_3
	cl = 0
	amount = x_2
	
tpid#3->Decision.t_valid\nDETERMINISTIC EC<7> , EC<8>"
	color=lawngreen
	shape=tripleoctagon
	style=filled
]
EC5 -> EC6 [
	label="fired atm_syst.t_timeout
	OUTPUT atm_SM:Abort
	"
]
EC5 -> EC7 [
	label="fired atm_syst.t_auth_cash
	INPUT atm_SM:Auth( auth_ok_4 )
	"
]
EC5 -> EC8 [
	label="fired atm_syst.t_abort_auth
	INPUT atm_SM:Auth( auth_ok_4 )
	"
]
EC5 -> EC41 [
	label="output atm_syst:Quiescence
	"
]
EC40 [
	label="ec_40< ev:0 , h:4 , w:1 >
atm_syst:Decision

PC: (exists< # : urational , $_1 : urational >(($_1 == x_2) && (z_3 < #)) && 
	(x_2 >= 10))
	$time = (z_1 + z_2 + z_3)
	z = z_3
	
QUIESCENCE"
	color=lightblue
	shape=ellipse
	style=filled
]
EC6 [
	label="ec_6< ev:0 , h:5 , w:2 >
atm_syst:Ready

PC: (($_1 == x_2) && (x_2 >= 10) && (z_4 >= 5))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	"
	color=lightblue
	shape=ellipse
	style=filled
]
EC7 [
	label="ec_7< ev:6 , h:5 , w:3 >
atm_syst:givecash

PC: ((auth_ok_4 == true) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	auth_ok = auth_ok_4
	
tpid#4->WaitingAuth.t_auth_cash"
	color=lawngreen
	shape=tripleoctagon
	style=filled
]
EC7 -> EC9 [
	label="fired atm_syst.t_cash
	OUTPUT atm_SM:Cash
	"
]
EC7 -> EC42 [
	label="output atm_syst:Quiescence
	"
]
EC8 [
	label="ec_8< ev:0 , h:5 , w:4 >
atm_syst:abortauth

PC: ((auth_ok_4 == false) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	auth_ok = auth_ok_4
	"
	color=lightblue
	shape=ellipse
	style=filled
]
EC41 [
	label="ec_41< ev:0 , h:5 , w:2 >
atm_syst:WaitingAuth

PC: (exists< # : urational >((z_4 < #) && (# >= 5)) && ($_1 == x_2) && (x_2 >= 
	10))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	
QUIESCENCE"
	color=lightblue
	shape=ellipse
	style=filled
]
EC9 [
	label="ec_9< ev:0 , h:6 , w:3 >
atm_syst:Ready

PC: ((auth_ok_4 == true) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4 + z_5)
	z = z_5
	cl = (z_4 + z_5)
	
tpid#5->givecash.t_cash"
	color=lawngreen
	shape=tripleoctagon
	style=filled
]
EC42 [
	label="ec_42< ev:0 , h:6 , w:3 >
atm_syst:givecash

PC: ((auth_ok_4 == true) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4 + z_5)
	z = z_5
	
QUIESCENCE"
	color=lightblue
	shape=ellipse
	style=filled
]
}