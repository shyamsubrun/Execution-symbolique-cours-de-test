@xlia< system , 1.0 >:

timed system atm_syst {

@composite:
    statemachine atm_SM {

    @public:
        port input  Init;
        port input  Wdrl(urational);
        port input  Auth(boolean);

        port output Debit(urational);
        port output Cash;
        port output Abort;

    @private:
        var clock urational cl;
        var urational wtb = 5;
        var urational threshold = 10;
        var urational amount = 0;
        var urational x = 0;
        var boolean auth_ok = false;

    @region:

        state< start > Idle {
            transition t_init --> Ready {
                input Init;
            }
        }

        state Ready {

            transition t_receive --> Decision {
                input Wdrl(x);
            }

        }

        state Decision {

            transition t_small --> Ready {
                guard ( x < threshold );
                output Abort;
            }

            transition t_valid --> WaitingAuth {
                guard ( x >= threshold );
                amount := x;
                output Debit(x);
                cl := 0;
            }

        }

        state WaitingAuth {

            transition t_timeout --> Ready {
                guard ( cl >= wtb );
                output Abort;
            }

            transition t_auth_cash --> givecash{
                input Auth(auth_ok);
                guard ( auth_ok == true );
            }

            transition t_abort_auth --> abortauth {
                input Auth(auth_ok);
                guard ( auth_ok == false );
               
            }
        }
        
        state givecash {
        	   transition t_cash --> Ready {
                output Cash;
            }	
        }
        
          state abortauth {
        	 transition t_abort --> Ready {
               
                output Abort;
            }	
        }

    @com:
        connect< env >{
            input Init;
            input Wdrl;
            input Auth;

            output Debit;
            output Cash;
            output Abort;
        }

    }

}