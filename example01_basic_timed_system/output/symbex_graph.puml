EC8: < ev:1 , h:0 , w:1 > 
EC8: Example01_Basic_Timed_System_S:q0
note left of EC8
$time = 0
	$delay = 0
	_clock_index_ = 0
	cl = 0
	
end note

EC8 -down-> EC9

state "EC 12" as EC12 << DefaultNode >>

EC12: < ev:1 , h:0 , w:1 > 
EC12: Example01_Basic_Timed_System_S:q0
note left of EC12
$time = 0
	$delay = 0
	_clock_index_ = 0
	cl = 0
	
end note

EC12 -down-> EC13

state "EC 1" as EC1 << PassedPath >>

EC1: < ev:2 , h:1 , w:1 > 
EC1: Example01_Basic_Timed_System_S:q0

EC1 -down-> EC2

EC1 -down-> EC16

state "EC 5" as EC5 << PassedPath >>

EC5: < ev:2 , h:1 , w:1 > 
EC5: Example01_Basic_Timed_System_S:q0

EC5 -down-> EC6

state "EC 9" as EC9 << PassedPath >>

EC9: < ev:2 , h:1 , w:1 > 
EC9: Example01_Basic_Timed_System_S:q0

EC9 -down-> EC10

state "EC 13" as EC13 << PassedPath >>

EC13: < ev:2 , h:1 , w:1 > 
EC13: Example01_Basic_Timed_System_S:q0

EC13 -down-> EC14

state "EC 2" as EC2 << PassedPath >>

EC2: < ev:3 , h:2 , w:1 > 
EC2: Example01_Basic_Timed_System_S:q1
note left of EC2
$time = $delay_1
	$delay = $delay_1
	
end note
EC2: ----
EC2: tpid#1->q0.tr1

EC2 -down-> EC3

EC2 -down-> EC17

state "EC 16" as EC16 << DefaultNode >>

EC16: < ev:0 , h:2 , w:1 > 
EC16: Example01_Basic_Timed_System_S:q0
note left of EC16
$time = $delay_1
	$delay = $delay_1
	
end note
EC16: ----
EC16: QUIESCENCE

