				guard (forall< # : uinteger , $_1 : integer >(((x_1 + yR_1) != 0) || ($_1 != yR_1) || (x_1 >= 0) || (z_2 >= #) || (# > 1)) && forall< # : uinteger , $_1 : integer >((yR_1 != x_1) || ($_1 != yR_1) || (z_2 >= #) || (# > 1) || (x_1 < 0)) && (exists< z_2 : uinteger >(((x_1 + yR_1) == 0) && ($_1 == yR_1) && (x_1 < 0) && (z_2 <= 1)) || exists< z_2 : uinteger >((yR_1 == x_1) && ($_1 == yR_1) && (z_2 <= 1) && (x_1 >= 0))));
