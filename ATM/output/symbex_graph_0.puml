
@startuml symbex_graph

' // scale 600 width

hide empty description

skinparam linetype polyline
' skinparam linetype ortho
' left to right direction

skinparam backgroundColor White
skinparam backgroundColor White
skinparam noteBorderColor White
skinparam shadowing false
skinparam notefontsize 16
skinparam notefontname Verdana
'skinparam notefontname Consolas
'skinparam noteShadowing false

skinparam state {
	StartColor Green
	EndColor Red

	'Attribut pour les transitions
	ArrowColor Black
	ArrowColor<< Else >> Orange

	'Attribut par défaut pour les états
	BorderColor Gray
	BackgroundColor Wheat

	'Attribut pour les noeuds/feuilles du graphes SymBex
	BackgroundColor<< DefaultNode >> LightBlue

	BackgroundColor<< RedondancyTargetSource >> Green
	BackgroundColor<< RedondancyTargetNode >> GreenYellow

	BackgroundColor<< PassedNode >> GreenYellow
	BackgroundColor<< FailedNode >> Red
	BackgroundColor<< InconclusiveNode >> Orange
	BackgroundColor<< AbortedNode >> Orange
	BackgroundColor<< WarningNode >> Orange
	BackgroundColor<< ErrorNode >> Red
	BackgroundColor<< AlertNode >> Red
	BackgroundColor<< ExitNode >> Red

	'Attribut pour les paths du graphes SymBex
	BackgroundColor<< PassedPath >> LawnGreen
	BackgroundColor<< FailedPath >> Red
	BackgroundColor<< InconclusiveNodePath >> Orange
	BackgroundColor<< AbortedPath >> Red

	FontColor Black
	FontName Times
	FontSize 14
}



state "EC 0" as EC0 << DefaultNode >>

EC0: < ev:1 , h:0 , w:1 > 
EC0: atm_syst:Idle
note left of EC0
$time = 0
	z = 0
	_clock_index_ = 0
	cl = 0
	wtb = 5
	threshold = 10
	amount = 0
	x = 0
	auth_ok = false
	
end note

EC0 -down-> EC1

state "EC 1" as EC1 << PassedPath >>

EC1: < ev:2 , h:1 , w:1 > 
EC1: atm_syst:Idle

EC1 -down-> EC2

EC1 -down-> EC38

state "EC 2" as EC2 << PassedPath >>

EC2: < ev:3 , h:2 , w:1 > 
EC2: atm_syst:Ready
note left of EC2
$time = z_1
	z = z_1
	cl = z_1
	
end note
EC2: ----
EC2: tpid#1->Idle.t_init

EC2 -down-> EC3

EC2 -down-> EC39

state "EC 38" as EC38 << DefaultNode >>

EC38: < ev:0 , h:2 , w:1 > 
EC38: atm_syst:Idle
note left of EC38
$time = z_1
	z = z_1
	
end note
EC38: ----
EC38: QUIESCENCE

state "EC 3" as EC3 << PassedPath >>

EC3: < ev:4 , h:3 , w:1 > 
EC3: atm_syst:Decision
note left of EC3
$time = (z_1 + z_2)
	z = z_2
	cl = (z_1 + z_2)
	x = x_2
	
end note
EC3: ----
EC3: tpid#2->Ready.t_receive\nDEAD_BRANCH_PRUNED\nEC< Id:4 PE:4 H:4 W:1 Q:0 > pid_4:Ready

EC3 -down-> EC5

EC3 -down-> EC40

state "EC 39" as EC39 << DefaultNode >>

EC39: < ev:0 , h:3 , w:1 > 
EC39: atm_syst:Ready
note left of EC39
$time = (z_1 + z_2)
	z = z_2
	
end note
EC39: ----
EC39: QUIESCENCE

state "EC 5" as EC5 << PassedPath >>

EC5: < ev:5 , h:4 , w:2 > 
EC5: atm_syst:WaitingAuth
note left of EC5
PC: (($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3)
	z = z_3
	cl = 0
	amount = x_2
	
end note
EC5: ----
EC5: tpid#3->Decision.t_valid\nDETERMINISTIC EC<7> , EC<8>

EC5 -down-> EC6

EC5 -down-> EC7

EC5 -down-> EC8

EC5 -down-> EC41

state "EC 40" as EC40 << DefaultNode >>

EC40: < ev:0 , h:4 , w:1 > 
EC40: atm_syst:Decision
note left of EC40
PC: (exists< # : urational , $_1 : urational >(($_1 == x_2) && (z_3 < #)) && 
	(x_2 >= 10))
	$time = (z_1 + z_2 + z_3)
	z = z_3
	
end note
EC40: ----
EC40: QUIESCENCE

state "EC 6" as EC6 << DefaultNode >>

EC6: < ev:0 , h:5 , w:2 > 
EC6: atm_syst:Ready
note left of EC6
PC: (($_1 == x_2) && (x_2 >= 10) && (z_4 >= 5))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	
end note

state "EC 7" as EC7 << PassedPath >>

EC7: < ev:6 , h:5 , w:3 > 
EC7: atm_syst:givecash
note left of EC7
PC: ((auth_ok_4 == true) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	auth_ok = auth_ok_4
	
end note
EC7: ----
EC7: tpid#4->WaitingAuth.t_auth_cash

EC7 -down-> EC9

EC7 -down-> EC42

state "EC 8" as EC8 << DefaultNode >>

EC8: < ev:0 , h:5 , w:4 > 
EC8: atm_syst:abortauth
note left of EC8
PC: ((auth_ok_4 == false) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	auth_ok = auth_ok_4
	
end note

state "EC 41" as EC41 << DefaultNode >>

EC41: < ev:0 , h:5 , w:2 > 
EC41: atm_syst:WaitingAuth
note left of EC41
PC: (exists< # : urational >((z_4 < #) && (# >= 5)) && ($_1 == x_2) && (x_2 >= 
	10))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	
end note
EC41: ----
EC41: QUIESCENCE

state "EC 9" as EC9 << PassedPath >>

EC9: < ev:0 , h:6 , w:3 > 
EC9: atm_syst:Ready
note left of EC9
PC: ((auth_ok_4 == true) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4 + z_5)
	z = z_5
	cl = (z_4 + z_5)
	
end note
EC9: ----
EC9: tpid#5->givecash.t_cash

state "EC 42" as EC42 << DefaultNode >>

EC42: < ev:0 , h:6 , w:3 > 
EC42: atm_syst:givecash
note left of EC42
PC: ((auth_ok_4 == true) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4 + z_5)
	z = z_5
	
end note
EC42: ----
EC42: QUIESCENCE
@enduml