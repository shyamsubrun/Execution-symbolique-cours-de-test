EC:<Id:0;Ev:1;H:0;W:1>{ SC: pid_3:Idle
	ALIAS{
		:ppid_-1:pid_0 = spec::atm_syst;
		:ppid_-1:pid_1 = spec::atm_syst;
			DATA{
				:ppid_-1:pid_1:$time = spec::atm_syst.$time;
				:ppid_-1:pid_1:z = spec::atm_syst.z;
				:ppid_-1:pid_1:_clock_index_ = spec::atm_syst._clock_index_;
			}
		:ppid_1:pid_2 = spec::atm_syst.atm_SM;
			DATA{
				:ppid_1:pid_2:cl = spec::atm_syst.atm_SM.cl;
				:ppid_1:pid_2:wtb = spec::atm_syst.atm_SM.wtb;
				:ppid_1:pid_2:threshold = spec::atm_syst.atm_SM.threshold;
				:ppid_1:pid_2:amount = spec::atm_syst.atm_SM.amount;
				:ppid_1:pid_2:x = spec::atm_syst.atm_SM.x;
				:ppid_1:pid_2:auth_ok = spec::atm_syst.atm_SM.auth_ok;
			}
			INTERFACE{
				:ppid_1:pid_2:Init = spec::atm_syst.atm_SM.Init;
				:ppid_1:pid_2:Wdrl = spec::atm_syst.atm_SM.Wdrl;
				:ppid_1:pid_2:Auth = spec::atm_syst.atm_SM.Auth;
				:ppid_1:pid_2:Debit = spec::atm_syst.atm_SM.Debit;
				:ppid_1:pid_2:Cash = spec::atm_syst.atm_SM.Cash;
				:ppid_1:pid_2:Abort = spec::atm_syst.atm_SM.Abort;
			}
		:ppid_2:pid_3 = spec::atm_syst.atm_SM.Idle;
		:ppid_2:pid_4 = spec::atm_syst.atm_SM.Ready;
		:ppid_2:pid_5 = spec::atm_syst.atm_SM.Decision;
		:ppid_2:pid_6 = spec::atm_syst.atm_SM.WaitingAuth;
		:ppid_2:pid_7 = spec::atm_syst.atm_SM.givecash;
		:ppid_2:pid_8 = spec::atm_syst.atm_SM.abortauth;
	}
	PC: true
	PtC: true
	DATA{
		:pid_1:$time = 0;
		:pid_1:z = 0;
		:pid_1:_clock_index_ = 0;
		:pid_2:cl = 0;
		:pid_2:wtb = 5;
		:pid_2:threshold = 10;
		:pid_2:amount = 0;
		:pid_2:x = 0;
		:pid_2:auth_ok = false;
	}
	EC:<Id:1;Ev:2;H:1;W:1>{ SC: pid_3:Idle
		EC:<Id:2;Ev:3;H:2;W:1>{ SC: pid_4:Ready
			EXE: { (:pid_2:atm_SM , run) (:pid_3:Idle , run) (:pid_3:Idle , 
	t_init) }
			TRACE: { (:pid_1:atm_syst , ${ newfresh inst::atm_syst.z 
	param::atm_syst.z_0 }) (:pid_3:Idle , ${ input#env inst::atm_syst.atm_SM.Init } 
	@ z_0) }
			/*FLAGS{ COVERAGE-ELEMENT }*/
			INFO{
				<ID:"sew:/workflow.behavior#selection.behavior_coverage",kind="tpid#1->Idle.t_init" as trace="tpid#1->Idle.t_init">
			}
			DATA{
				:pid_1:$time = z_0;
				:pid_1:z = z_0;
				:pid_2:cl = z_0;
			}
			EC:<Id:3;Ev:4;H:3;W:1>{ SC: pid_5:Decision
				EXE: { (:pid_2:atm_SM , run) (:pid_4:Ready , run) (:pid_4:Ready 
	, t_receive) }
				TRACE: { (:pid_1:atm_syst , ${ newfresh inst::atm_syst.z 
	param::atm_syst.z_1 }) (:pid_4:Ready , ${ input#env inst::atm_syst.atm_SM.Wdrl 
	param::atm_syst.atm_SM.x_0 } @ (z_0 + z_1)) }
				/*FLAGS{ COVERAGE-ELEMENT }*/
				INFO{
					<ID:"sew:/workflow.behavior#selection.behavior_coverage",kind="tpid#2->Ready.t_receive" as trace="tpid#2->Ready.t_receive">
				}
				DATA{
					:pid_1:$time = (z_0 + z_1);
					:pid_1:z = z_1;
					:pid_2:cl = (z_0 + z_1);
					:pid_2:x = x_0;
				}
				EC:<Id:5;Ev:5;H:4;W:2>{ SC: pid_6:WaitingAuth
					EXE: { (:pid_2:atm_SM , run) (:pid_5:Decision , run) 
	(:pid_5:Decision , t_valid) }
					TRACE: { (:pid_1:atm_syst , ${ newfresh inst::atm_syst.z 
	param::atm_syst.z_2 }) (:pid_5:Decision , ${ output#env 
	inst::atm_syst.atm_SM.Debit param::atm_syst.atm_SM.x_0 } @ (z_0 + z_1 + z_2)) }
					/*FLAGS{ COVERAGE-ELEMENT }*/
					INFO{
						<ID:"sew:/workflow.behavior#selection.behavior_coverage",kind="tpid#3->Decision.t_valid" as trace="tpid#3->Decision.t_valid">
					}
					PC: (x_0 >= 10)
					DATA{
						:pid_1:$time = (z_0 + z_1 + z_2);
						:pid_1:z = z_2;
						:pid_2:cl = 0;
						:pid_2:amount = x_0;
					}
					EC:<Id:7;Ev:7;H:5;W:3>{ SC: pid_7:givecash
						EXE: { (:pid_2:atm_SM , run) (:pid_6:WaitingAuth , run) 
	(:pid_6:WaitingAuth , t_auth_cash) }
						TRACE: { (:pid_1:atm_syst , ${ newfresh inst::atm_syst.z 
	param::atm_syst.z_3 }) (:pid_6:WaitingAuth , ${ input#env 
	inst::atm_syst.atm_SM.Auth param::atm_syst.atm_SM.auth_ok_0 } @ (z_0 + z_1 + z_2 
	+ z_3)) }
						/*FLAGS{ COVERAGE-ELEMENT & OBJECTIVE-ACHIEVED }*/
						INFO{
							<ID:"sew:/workflow.behavior#selection.behavior_coverage",kind="tpid#4->WaitingAuth.t_auth_cash" as trace="tpid#4->WaitingAuth.t_auth_cash">
						}
						PC: ((auth_ok_0 == true) && (x_0 >= 10))
						DATA{
							:pid_1:$time = (z_0 + z_1 + z_2 + z_3);
							:pid_1:z = z_3;
							:pid_2:cl = z_3;
							:pid_2:auth_ok = auth_ok_0;
						}
					}
				}
			}
		}
	}
}
