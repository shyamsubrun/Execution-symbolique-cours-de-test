
@startuml symbex_graph

' // scale 600 width

hide empty description

skinparam linetype polyline
' skinparam linetype ortho
' left to right direction

skinparam backgroundColor White
skinparam backgroundColor White
skinparam noteBorderColor White
skinparam shadowing false
skinparam notefontsize 16
skinparam notefontname Verdana
'skinparam notefontname Consolas
'skinparam noteShadowing false

skinparam state {
	StartColor Green
	EndColor Red

	'Attribut pour les transitions
	ArrowColor Black
	ArrowColor<< Else >> Orange

	'Attribut par défaut pour les états
	BorderColor Gray
	BackgroundColor Wheat

	'Attribut pour les noeuds/feuilles du graphes SymBex
	BackgroundColor<< DefaultNode >> LightBlue

	BackgroundColor<< RedondancyTargetSource >> Green
	BackgroundColor<< RedondancyTargetNode >> GreenYellow

	BackgroundColor<< PassedNode >> GreenYellow
	BackgroundColor<< FailedNode >> Red
	BackgroundColor<< InconclusiveNode >> Orange
	BackgroundColor<< AbortedNode >> Orange
	BackgroundColor<< WarningNode >> Orange
	BackgroundColor<< ErrorNode >> Red
	BackgroundColor<< AlertNode >> Red
	BackgroundColor<< ExitNode >> Red

	'Attribut pour les paths du graphes SymBex
	BackgroundColor<< PassedPath >> LawnGreen
	BackgroundColor<< FailedPath >> Red
	BackgroundColor<< InconclusiveNodePath >> Orange
	BackgroundColor<< AbortedPath >> Red

	FontColor Black
	FontName Times
	FontSize 14
}



state "EC 20" as EC20 << DefaultNode >>

EC20: < ev:1 , h:0 , w:1 > 
EC20: Example02_Dummy_S:q0
note left of EC20
$time = 0
	$delay = 0
	_clock_index_ = 0
	sum = sum_0
	x = x_0
	cl = 0
	
end note

EC20 -down-> EC21

state "EC 21" as EC21 << PassedPath >>

EC21: < ev:2 , h:1 , w:1 > 
EC21: Example02_Dummy_S:q0
note left of EC21
sum = 0
	
end note

EC21 -down-> EC22

state "EC 22" as EC22 << PassedPath >>

EC22: < ev:3 , h:2 , w:1 > 
EC22: Example02_Dummy_S:q1
note left of EC22
PC: ((0 <= (x_1 + -1)) && (x_1 <= 10))
	$time = $delay_1
	$delay = $delay_1
	sum = x_1
	x = x_1
	
end note
EC22: ----
EC22: tpid#1->q0.tr1\nDEAD_BRANCH_PRUNED
EC< Id:4 PE:3 H:3 W:2 Q:0 > pid_3:q0

EC22 -down-> EC23

state "EC 23" as EC23 << PassedPath >>

EC23: < ev:4 , h:3 , w:1 > 
EC23: Example02_Dummy_S:q0
note left of EC23
PC: ((($delay_2 + x_1) == 42) && ($_1 == 0) && (0 <= (x_1 + -1)) && (x_1 <= 5) 
	&& (x_1 <= 10))
	$time = ($delay_1 + $delay_2)
	$delay = $delay_2
	cl = $delay_2
	
end note
EC23: ----
EC23: tpid#2->q1.tr2

EC23 -down-> EC24

state "EC 24" as EC24 << PassedPath >>

EC24: < ev:5 , h:4 , w:1 > 
EC24: Example02_Dummy_S:q1
note left of EC24
PC: ((($delay_2 + x_1) == 42) && ($_1 == 0) && (0 <= (x_1 + -1)) && (0 <= (x_3 + 
	-1)) && (x_1 <= 5) && (x_1 <= 10) && (x_3 <= 10))
	$time = ($delay_1 + $delay_2 + $delay_3)
	$delay = $delay_3
	sum = (x_1 + x_3)
	x = x_3
	cl = 0
	
end note
EC24: ----
EC24: tpid#3->q0.tr1\nDEAD_BRANCH_PRUNED
EC< Id:6 PE:5 H:5 W:1 Q:0 > pid_3:q0

EC24 -down-> EC25

state "EC 25" as EC25 << PassedPath >>

EC25: < ev:6 , h:5 , w:3 > 
EC25: Example02_Dummy_S:q0
note left of EC25
PC: ((($delay_2 + x_1) == 42) && (($delay_4 + x_3) == 42) && ($_1 == 0) && ($_2 
	== x_3) && (0 <= (x_1 + -1)) && (0 <= (x_3 + -1)) && (x_1 <= 5) && (x_1 <= 10) 
	&& (x_3 <= 10) && (x_3 > 5))
	$time = ($delay_1 + $delay_2 + $delay_3 + $delay_4)
	$delay = $delay_4
	cl = $delay_4
	
end note
EC25: ----
EC25: tpid#4->q1.tr3

EC25 -down-> EC26

EC25 -down-> EC27

state "EC 26" as EC26 << DefaultNode >>

EC26: < ev:0 , h:6 , w:3 > 
EC26: Example02_Dummy_S:q1
note left of EC26
PC: ((($delay_2 + x_1) == 42) && (($delay_4 + x_3) == 42) && ($_1 == 0) && ($_2 
	== x_3) && (0 <= (x_1 + -1)) && (0 <= (x_3 + -1)) && (0 <= (x_5 + -1)) && (x_1 
	<= 5) && (x_1 <= 10) && (x_3 <= 10) && (x_5 <= 10) && (x_3 > 5))
	$time = ($delay_1 + $delay_2 + $delay_3 + $delay_4 + $delay_5)
	$delay = $delay_5
	sum = (x_1 + x_3 + x_5)
	x = x_5
	cl = 0
	
end note

state "EC 27" as EC27 << PassedPath >>

EC27: < ev:0 , h:6 , w:4 > 
EC27: Example02_Dummy_S:q2
note left of EC27
PC: ((($delay_2 + x_1) == 42) && (($delay_4 + x_3) == 42) && ($_1 == 0) && ($_2 
	== x_3) && (0 <= (x_1 + -1)) && (0 <= (x_3 + -1)) && (x_1 <= 5) && (x_1 <= 10) 
	&& (x_3 <= 10) && (x_3 > 5) && ((x_1 + x_3) >= 15))
	$time = ($delay_1 + $delay_2 + $delay_3 + $delay_4 + $delay_5)
	$delay = $delay_5
	cl = ($delay_4 + $delay_5)
	
end note
EC27: ----
EC27: tpid#5->q0.tr4\nFINALIZE
EC27: STATEMENT-EXIT & COVERAGE-ELEMENT & OBJECTIVE-ACHIEVED
@enduml