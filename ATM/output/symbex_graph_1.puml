
@startuml symbex_graph

' // scale 600 width

hide empty description

skinparam linetype polyline
' skinparam linetype ortho
' left to right direction

skinparam backgroundColor White
skinparam backgroundColor White
skinparam noteBorderColor White
skinparam shadowing false
skinparam notefontsize 16
skinparam notefontname Verdana
'skinparam notefontname Consolas
'skinparam noteShadowing false

skinparam state {
	StartColor Green
	EndColor Red

	'Attribut pour les transitions
	ArrowColor Black
	ArrowColor<< Else >> Orange

	'Attribut par défaut pour les états
	BorderColor Gray
	BackgroundColor Wheat

	'Attribut pour les noeuds/feuilles du graphes SymBex
	BackgroundColor<< DefaultNode >> LightBlue

	BackgroundColor<< RedondancyTargetSource >> Green
	BackgroundColor<< RedondancyTargetNode >> GreenYellow

	BackgroundColor<< PassedNode >> GreenYellow
	BackgroundColor<< FailedNode >> Red
	BackgroundColor<< InconclusiveNode >> Orange
	BackgroundColor<< AbortedNode >> Orange
	BackgroundColor<< WarningNode >> Orange
	BackgroundColor<< ErrorNode >> Red
	BackgroundColor<< AlertNode >> Red
	BackgroundColor<< ExitNode >> Red

	'Attribut pour les paths du graphes SymBex
	BackgroundColor<< PassedPath >> LawnGreen
	BackgroundColor<< FailedPath >> Red
	BackgroundColor<< InconclusiveNodePath >> Orange
	BackgroundColor<< AbortedPath >> Red

	FontColor Black
	FontName Times
	FontSize 14
}



state "EC 10" as EC10 << DefaultNode >>

EC10: < ev:1 , h:0 , w:1 > 
EC10: atm_syst:Idle
note left of EC10
$time = 0
	z = 0
	_clock_index_ = 0
	cl = 0
	wtb = 5
	threshold = 10
	amount = 0
	x = 0
	auth_ok = false
	
end note

EC10 -down-> EC11

state "EC 11" as EC11 << PassedPath >>

EC11: < ev:2 , h:1 , w:1 > 
EC11: atm_syst:Idle

EC11 -down-> EC12

state "EC 12" as EC12 << PassedPath >>

EC12: < ev:3 , h:2 , w:1 > 
EC12: atm_syst:Ready
note left of EC12
$time = z_1
	z = z_1
	cl = z_1
	
end note
EC12: ----
EC12: tpid#1->Idle.t_init

EC12 -down-> EC13

state "EC 13" as EC13 << PassedPath >>

EC13: < ev:4 , h:3 , w:1 > 
EC13: atm_syst:Decision
note left of EC13
$time = (z_1 + z_2)
	z = z_2
	cl = (z_1 + z_2)
	x = x_2
	
end note
EC13: ----
EC13: tpid#2->Ready.t_receive\nDEAD_BRANCH_PRUNED\nEC< Id:4 PE:4 H:4 W:1 Q:0 > pid_4:Ready

EC13 -down-> EC14

EC13 -down-> EC15

state "EC 14" as EC14 << DefaultNode >>

EC14: < ev:0 , h:4 , w:1 > 
EC14: atm_syst:Ready
note left of EC14
PC: (x_2 < 10)
	$time = (z_1 + z_2 + z_3)
	z = z_3
	cl = (z_1 + z_2 + z_3)
	
end note

state "EC 15" as EC15 << PassedPath >>

EC15: < ev:5 , h:4 , w:2 > 
EC15: atm_syst:WaitingAuth
note left of EC15
PC: (($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3)
	z = z_3
	cl = 0
	amount = x_2
	
end note
EC15: ----
EC15: tpid#3->Decision.t_valid\nDETERMINISTIC EC<7> , EC<8>

EC15 -down-> EC16

EC15 -down-> EC17

EC15 -down-> EC19

state "EC 16" as EC16 << DefaultNode >>

EC16: < ev:0 , h:5 , w:2 > 
EC16: atm_syst:Ready
note left of EC16
PC: (($_1 == x_2) && (x_2 >= 10) && (z_4 >= 5))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	
end note

state "EC 17" as EC17 << PassedPath >>

EC17: < ev:6 , h:5 , w:3 > 
EC17: atm_syst:givecash
note left of EC17
PC: ((auth_ok_4 == true) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	auth_ok = auth_ok_4
	
end note
EC17: ----
EC17: tpid#4->WaitingAuth.t_auth_cash

EC17 -down-> EC18

state "EC 19" as EC19 << DefaultNode >>

EC19: < ev:0 , h:5 , w:4 > 
EC19: atm_syst:abortauth
note left of EC19
PC: ((auth_ok_4 == false) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4)
	z = z_4
	cl = z_4
	auth_ok = auth_ok_4
	
end note

state "EC 18" as EC18 << PassedPath >>

EC18: < ev:0 , h:6 , w:3 > 
EC18: atm_syst:Ready
note left of EC18
PC: ((auth_ok_4 == true) && ($_1 == x_2) && (x_2 >= 10))
	$time = (z_1 + z_2 + z_3 + z_4 + z_5)
	z = z_5
	cl = (z_4 + z_5)
	
end note
EC18: ----
EC18: tpid#5->givecash.t_cash
@enduml