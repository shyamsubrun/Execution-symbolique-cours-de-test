	shape=tripleoctagon
	style=filled
]
EC17 [
	label="ec_17< ev:0 , h:3 , w:1 >
Example01_Basic_Timed_System_S:q1

PC: exists< # : urational >(($delay_2 < #) && (# <= 5))
	$time = ($delay_1 + $delay_2)
	$delay = $delay_2
	
QUIESCENCE"
	color=lightblue
	shape=ellipse
	style=filled
]
}