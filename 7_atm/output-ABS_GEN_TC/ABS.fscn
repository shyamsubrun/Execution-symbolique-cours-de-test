				TRACE: { (:pid_1:MySys , ${ newfresh inst::MySys.z 
	param::MySys.z_2 }) (:pid_4:Compute , ${ output#env inst::MySys.ABS.Res 
	prot::MySys.ABS.Ready.$_1 } @ (z_1 + z_2)) }
				NC: ((yR_1 == x_1) && ($_1 == yR_1) && (z_2 <= 1) && (x_1 >= 0))
