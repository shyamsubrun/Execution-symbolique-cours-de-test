digraph BankSystem {
compound = true;
fontsize = 12
	subgraph "cluster_spec::BankSystem" {
		label = "SYSTEM spec::BankSystem"

		subgraph "cluster_spec::BankSystem.Bank_SM" {
			label = "Bank_SM"
			style=dashed;

			"spec::BankSystem.Bank_SM"
			[
				label = "Bank_SM"
				shape=point, style=invis, color=white
			];

			"spec::BankSystem.Bank_SM.InitState"
			[
				label = "InitState"
				shape=ellipse, style="bold,filled", fillcolor=green
			];

			"spec::BankSystem.Bank_SM.InitState" -> "spec::BankSystem.Bank_SM.Idle" [ label = "t_init" ];

			"spec::BankSystem.Bank_SM.Idle"
			[
				label = "Idle"
				shape=ellipse, style="bold,filled", color=skyblue
			];

			"spec::BankSystem.Bank_SM.Idle" -> "spec::BankSystem.Bank_SM.Idle" [ label = "t_new_day" ];

			"spec::BankSystem.Bank_SM.Idle" -> "spec::BankSystem.Bank_SM.Idle" [ label = "t_lock_update" ];

			"spec::BankSystem.Bank_SM.Idle" -> "spec::BankSystem.Bank_SM.Idle" [ label = "t_unlock" ];

			"spec::BankSystem.Bank_SM.Idle" -> "spec::BankSystem.Bank_SM.Idle" [ label = "t_check" ];

			"spec::BankSystem.Bank_SM.Idle" -> "spec::BankSystem.Bank_SM.Idle" [ label = "t_reply_check" ];

			"spec::BankSystem.Bank_SM.Idle" -> "spec::BankSystem.Bank_SM.Decision" [ label = "t_receive" ];

			"spec::BankSystem.Bank_SM.Decision"
			[
				label = "Decision"
				shape=ellipse, style="bold,filled", color=skyblue
			];

			"spec::BankSystem.Bank_SM.Decision" -> "spec::BankSystem.Bank_SM.ReplyState" [ label = "t_locked" ];

			"spec::BankSystem.Bank_SM.Decision" -> "spec::BankSystem.Bank_SM.ReplyState" [ label = "t_small" ];

			"spec::BankSystem.Bank_SM.Decision" -> "spec::BankSystem.Bank_SM.ReplyState" [ label = "t_no_balance" ];

			"spec::BankSystem.Bank_SM.Decision" -> "spec::BankSystem.Bank_SM.ReplyState" [ label = "t_limit" ];

			"spec::BankSystem.Bank_SM.Decision" -> "spec::BankSystem.Bank_SM.ReplyState" [ label = "t_accept" ];

			"spec::BankSystem.Bank_SM.ReplyState"
			[
				label = "ReplyState"
				shape=ellipse, style="bold,filled", color=skyblue
			];

			"spec::BankSystem.Bank_SM.ReplyState" -> "spec::BankSystem.Bank_SM.Idle" [ label = "t_send_reply" ];
		}
	}
}

