			target = inout parameter var< id:0, ptr:std > vector< clock< urational > > inst::atm_syst.clock#update#vector._clock_vector_;
			value = _clock_index_;
		}
		inout parameter var< id:0, ptr:mix > clock< urational > inst::atm_syst.clock#update#vector._clock_vector_[_clock_index_] '_clock_vector_[_clock_index_]' {
			target = inout parameter var< id:0, ptr:std > vector< clock< urational > > inst::atm_syst.clock#update#vector._clock_vector_;
			value = _clock_index_;
		}
	time:
		var< id:0, ptr:std > time< urational > inst::atm_syst.$time
		var< id:1, ptr:std > time< urational > inst::atm_syst.z
	model:
		timed #model instance< id:0, multiplicity: [ 1 ], this > model::atm_syst.$this;
		#model instance< id:1, multiplicity: [ + ] > model::atm_syst.atm_SM;
	instance:
		timed #static instance< id:0, multiplicity: [ 1 ], this > &exec::atm_syst prot::atm_syst.$this {
			//model = model::atm_syst.$this;
		}
		#prototype instance< id:1, multiplicity: [ + ] > prot::atm_syst.atm_SM {
			//model = model::atm_syst.atm_SM;
			rid#runtime = run::pid_2:atm_syst.atm_SM;
			@create{ |§|
				cl := 0;
				wtb := 5;
				threshold := 10;
			}
		}
	program:
		macro routine< id:0 > routine::atm_syst.time#get {
		returns:
			return transient parameter var< id:0, ptr:std > time< urational > inst::atm_syst.time#get._time_ '_time_';
		moe:
			@run{ |§|
				_time_ := $time;
				return;
			 }
		opcode#family = basic;
		}

		macro routine< id:1 > routine::atm_syst.delta#get {
		returns:
			return transient parameter var< id:0, ptr:std > time< urational > inst::atm_syst.delta#get._delta_ '_delta_';
		moe:
			@run{ |§|
				_delta_ := z;
				return;
			 }
		opcode#family = basic;
		}

		macro routine< id:2 > routine::atm_syst.time#reset {
		moe:
			@run{
				$time := 0;
			 }
		opcode#family = basic;
		}

		macro routine< id:3 > routine::atm_syst.clock#reset {
		parameter:
			inout parameter var< id:0, ptr:std > clock< urational > inst::atm_syst.clock#reset._clock_ '_clock_';
		moe:
			@run{
				_clock_ := 0;
			 }
		opcode#family = basic;
		}

		macro routine< id:4 > routine::atm_syst.clock#update {
		parameter:
			inout parameter var< id:0, ptr:std > clock< urational > inst::atm_syst.clock#update._clock_ '_clock_';
		moe:
			@run{
				_clock_ := (_clock_ + z);
			 }
		opcode#family = basic;
		}

		macro routine< id:5 > routine::atm_syst.clock#reset#vector {
		parameter:
			inout parameter var< id:0, ptr:std > vector< clock< urational > > inst::atm_syst.clock#reset#vector._clock_vector_ '_clock_vector_';
		moe:
			@run{
				for( _clock_index_ := 0 ; (_clock_index_ < size(_clock_vector_)) ; _clock_index_ := (_clock_index_ + 1) )
				{
					_clock_vector_[_clock_index_] := 0;
				}
			 }
		opcode#family = basic;
		}

		macro routine< id:6 > routine::atm_syst.clock#update#vector {
		parameter:
			inout parameter var< id:0, ptr:std > vector< clock< urational > > inst::atm_syst.clock#update#vector._clock_vector_ '_clock_vector_';
		moe:
			@run{
				for( _clock_index_ := 0 ; (_clock_index_ < size(_clock_vector_)) ; _clock_index_ := (_clock_index_ + 1) )
				{
					_clock_vector_[_clock_index_] := (_clock_vector_[_clock_index_] + z);
				}
			 }
		opcode#family = basic;
		}

		macro routine< id:7 > routine::atm_syst.time#update {
		moe:
			@run{ |§|
				newfresh(z)
				$time := ($time + z);
				if ${ status#is enable atm_SM }
				{
					cl := (cl + z);
				}
			 }
		opcode#family = basic;
		}

	moe:
		@create{ |§|
			$time := 0;
			z := 0;
			_clock_index_ := 0;
		}
		@init{
			{ |§|
				$time := 0;
				z := 0;
			}
			init atm_SM;
		}
		@final{
			process#state#set $this final;
			exit "FINALIZE";
		}
		@start{
			{ |§|
				$time := 0;
				z := 0;
			}
			init atm_SM;
		}
		@enable{
			enable atm_SM;
		}
		@disable{
			disable atm_SM;
		}
		@abort{
			abort#set atm_SM;
		}
		@run{
			{ |§|
				newfresh(z)
				$time := ($time + z);
				if ${ status#is enable atm_SM }
				{
					cl := (cl + z);
				}
			}
			schedule $self;
		}
		@schedule< final >{
			run atm_SM;
		}
		@concurrency{ |i| }
		opcode#family = basic | guard | input | output;
	}

	#prototype executable< moc: or % statemachine , id:1, instanciation: [ + ] > exec::atm_syst.atm_SM {
		weak#lifeline = true;
	variable:
		public volatile var< id:0, ptr:std > clock< urational > inst::atm_syst.atm_SM.cl 'cl' {
			rid#container = run::pid_2:atm_syst.atm_SM;
			value = 0;
		}
		var< id:1, ptr:std > urational inst::atm_syst.atm_SM.wtb 'wtb' {
			rid#container = run::pid_2:atm_syst.atm_SM;
			value = 5;
		}
		var< id:2, ptr:std > urational inst::atm_syst.atm_SM.threshold 'threshold' {
			rid#container = run::pid_2:atm_syst.atm_SM;
			value = 10;
		}
	port:
		public input port< id:0 , route:0 > inst::atm_syst.atm_SM.Init {
			rid#container = run::pid_2:atm_syst.atm_SM;
			routing#input#data = routing< env , mid:1 > run::pid_2:atm_syst.atm_SM;
		}
		public input port< id:1 , route:1 > inst::atm_syst.atm_SM.Wdrl {
			rid#container = run::pid_2:atm_syst.atm_SM;
			routing#input#data = routing< env , mid:1 > run::pid_2:atm_syst.atm_SM;
		}
		public input port< id:2 , route:2 > inst::atm_syst.atm_SM.Auth {
			rid#container = run::pid_2:atm_syst.atm_SM;
			routing#input#data = routing< env , mid:1 > run::pid_2:atm_syst.atm_SM;
		}
		public output port< id:0 , route:0 > inst::atm_syst.atm_SM.Debit {
			rid#container = run::pid_2:atm_syst.atm_SM;
			routing#output#data = routing< env , mid:1 > run::pid_2:atm_syst.atm_SM;
		}
		public output port< id:1 , route:1 > inst::atm_syst.atm_SM.Cash {
			rid#container = run::pid_2:atm_syst.atm_SM;
			routing#output#data = routing< env , mid:1 > run::pid_2:atm_syst.atm_SM;
		}
		public output port< id:2 , route:2 > inst::atm_syst.atm_SM.Abort {
			rid#container = run::pid_2:atm_syst.atm_SM;
			routing#output#data = routing< env , mid:1 > run::pid_2:atm_syst.atm_SM;
		}
	connector:/* < exec::atm_syst.atm_SM > */
		connector< id:0 , mid:1 , env > inst::atm_syst.atm_SM._#connector_0 {
			output {
				prot::atm_syst.atm_SM.$this->Debit;
				prot::atm_syst.atm_SM.$this->Cash;
				prot::atm_syst.atm_SM.$this->Abort;
			}
			input {
				prot::atm_syst.atm_SM.$this->Init;
				prot::atm_syst.atm_SM.$this->Wdrl;
				prot::atm_syst.atm_SM.$this->Auth;
			}
		}
	router:
		router prot::atm_syst.atm_SM.$this< exec::atm_syst.atm_SM > {
		input:
			routing< env , mid:1 > inst::atm_syst.atm_SM.Init {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
			routing< env , mid:1 > inst::atm_syst.atm_SM.Wdrl {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
			routing< env , mid:1 > inst::atm_syst.atm_SM.Auth {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
		output:
			routing< env , mid:1 > inst::atm_syst.atm_SM.Debit {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
			routing< env , mid:1 > inst::atm_syst.atm_SM.Cash {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
			routing< env , mid:1 > inst::atm_syst.atm_SM.Abort {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
		}

		routeur<null>
		routeur<null>
		routeur<null>

	router#model:
		router prot::atm_syst.atm_SM.$this< exec::atm_syst.atm_SM > {
		input:
			routing< env , mid:1 > inst::atm_syst.atm_SM.Init {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
			routing< env , mid:1 > inst::atm_syst.atm_SM.Wdrl {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
			routing< env , mid:1 > inst::atm_syst.atm_SM.Auth {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
		output:
			routing< env , mid:1 > inst::atm_syst.atm_SM.Debit {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
			routing< env , mid:1 > inst::atm_syst.atm_SM.Cash {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
			routing< env , mid:1 > inst::atm_syst.atm_SM.Abort {
				connector = inst::atm_syst.atm_SM._#connector_0;
			}
		}

	model:
		#model instance< id:0, multiplicity: [ 1 ], this > model::atm_syst.atm_SM.$this;
	instance:
		#static instance< id:0, multiplicity: [ 1 ], this > &exec::atm_syst.atm_SM prot::atm_syst.atm_SM.$this {
			//model = model::atm_syst.atm_SM.$this;
		}
		#prototype instance< id:1, multiplicity: [ + ] > prot::atm_syst.atm_SM.Idle {
			rid#runtime = run::pid_3:atm_syst.atm_SM.Idle;
		}
		#prototype instance< id:2, multiplicity: [ + ] > prot::atm_syst.atm_SM.Ready {
			rid#runtime = run::pid_4:atm_syst.atm_SM.Ready;
		}
		#prototype instance< id:3, multiplicity: [ + ] > prot::atm_syst.atm_SM.WaitingAuth {
			rid#runtime = run::pid_5:atm_syst.atm_SM.WaitingAuth;
		}
	moe:
		@create{ |§|
			cl := 0;
			wtb := 5;
			threshold := 10;
		}
		@init{
			init Idle;
		}
		@enable{
			@comment "nop<enable> exec::atm_syst.atm_SM.Idle";
		}
		@disable{ |§|
			disable#child;
			disable#self;
		}
		@run{
			schedule $self;
		}
		@schedule{
			run Idle;
		}
		opcode#family = basic | guard | input | output;
	}

	#prototype executable< moc: start % state , id:2, instanciation: [ * ] > exec::atm_syst.atm_SM.Idle {
	transition:
		transition< id:0 > t_init --> Ready {
		moe:
			@run{
				input Init;
				{ |§|
					disable#set Idle;
					enable#set Ready;
				}
			}
			opcode#family = input;
			communication<final>{
				input Init;
			}
			com#internal{
				input Init;
			}
			com#input{
				inst::atm_syst.atm_SM.Init
			}
			com#input_enabled{
				inst::atm_syst.atm_SM.Init
			}
		}
	moe:
		@run{
			invoke#transition Idle.t_init;
		}
		opcode#family = input;
	}

	#prototype executable< moc: simple % state , id:3, instanciation: [ * ] > exec::atm_syst.atm_SM.Ready {
	transition:
		transition< id:0 > t_abort_small --> Ready {
		moe:
			@run{
				input Wdrl;
				{ |§|
					guard (threshold > 0);
					output Abort;
				}
				{ |§|
					disable#set Ready;
					enable#set Ready;
				}
			}
			opcode#family = guard | input | output;
			communication<final>{
				input Wdrl;
				output Abort;
			}
			com#internal{
				input Wdrl;
				output Abort;
			}
			com#input{
				inst::atm_syst.atm_SM.Wdrl
			}
			com#output{
				inst::atm_syst.atm_SM.Abort
			}
			com#input_enabled{
				inst::atm_syst.atm_SM.Wdrl
			}
		}
		transition< id:1 > t_send_debit --> WaitingAuth {
		moe:
			@run{
				input Wdrl;
				output Debit;
				{ |§|
					cl := 0;
					disable#set Ready;
					enable#set WaitingAuth;
				}
			}
			opcode#family = basic | input | output;
			communication<final>{
				input Wdrl;
				output Debit;
			}
			com#internal{
				input Wdrl;
				output Debit;
			}
			com#input{
				inst::atm_syst.atm_SM.Wdrl
			}
			com#output{
				inst::atm_syst.atm_SM.Debit
			}
			com#input_enabled{
				inst::atm_syst.atm_SM.Wdrl
			}
		}
	moe:
		@run{ |/\|
			invoke#transition Ready.t_abort_small;
			invoke#transition Ready.t_send_debit;
		}
		opcode#family = basic | guard | input | output;
	}

	#prototype executable< moc: simple % state , id:4, instanciation: [ * ] > exec::atm_syst.atm_SM.WaitingAuth {
	transition:
		transition< id:0 > t_timeout --> Ready {
		moe:
			@run{
				{ |§|
					guard (cl > wtb);
					output Abort;
				}
				{ |§|
					disable#set WaitingAuth;
					enable#set Ready;
				}
			}
			opcode#family = guard | output;
			communication<final>{
				output Abort;
			}
			com#internal{
				output Abort;
			}
			com#output{
				inst::atm_syst.atm_SM.Abort
			}
		}
		transition< id:1 > t_cash --> Ready {
		moe:
			@run{
				input Auth;
				output Cash;
				{ |§|
					disable#set WaitingAuth;
					enable#set Ready;
				}
			}
			opcode#family = input | output;
			communication<final>{
				input Auth;
				output Cash;
			}
			com#internal{
				input Auth;
				output Cash;
			}
			com#input{
				inst::atm_syst.atm_SM.Auth
			}
			com#output{
				inst::atm_syst.atm_SM.Cash
			}
			com#input_enabled{
				inst::atm_syst.atm_SM.Auth
			}
		}
		transition< id:2 > t_abort_auth --> Ready {
		moe:
			@run{
				input Auth;
				output Abort;
				{ |§|
					disable#set WaitingAuth;
					enable#set Ready;
				}
			}
			opcode#family = input | output;
			communication<final>{
				input Auth;
				output Abort;
			}
			com#internal{
				input Auth;
				output Abort;
			}
			com#input{
				inst::atm_syst.atm_SM.Auth
			}
			com#output{
				inst::atm_syst.atm_SM.Abort
			}
			com#input_enabled{
				inst::atm_syst.atm_SM.Auth
			}
		}
	moe:
		@run{ |/\|
			invoke#transition WaitingAuth.t_timeout;
			invoke#transition WaitingAuth.t_cash;
			invoke#transition WaitingAuth.t_abort_auth;
		}
		opcode#family = guard | input | output;
	}

