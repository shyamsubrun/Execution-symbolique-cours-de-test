xfsp< executable , 1.0 >:

// timed #prototype system< moc: and % system > atm_syst {
header:
	fqn_id = sys::atm_syst
	description = "the result of the system compilation"
	count = 5

instance:
	// The Parameters Machine Instance
	timed #prototype instance< id:0, multiplicity: [ 0, 1 ] > inst::#PARAMETERS#;

	// The System Machine Instance
	timed #prototype instance< id:0, multiplicity: [ 1 ] > prot::atm_syst {
		rid#runtime = run::pid_1:atm_syst;
		@create{ |§|
			$time := 0;
			z := 0;
			_clock_index_ := 0;
		}
		@start{
			{ |§|
				$time := 0;
				z := 0;
			}
			init atm_SM;
		}
	}

executable:
	timed #prototype executable< moc: and % system , id:0, instanciation: [ + ] > exec::#PARAMETERS# {
	moe:
	}

	timed #prototype executable< moc: and % system , id:0, instanciation: [ + ] > exec::atm_syst {
		weak#lifeline = true;
	variable:
		public static const< id:0, ptr:std > time< urational > inst::atm_syst.$time#initial '$time#initial' {
			rid#container = run::pid_0:#PARAMETERS#;
			value = 0;
