    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_ADAPTATION_MODULE_NAME" value="TTCN_Adaptation"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_ADAPTATION_UTILS_IMPL" value="&#9;// A testcase could just call the function below, when it needs to wait for a timeout.&#13;&#10;&#9;// In case the user wants he can activated altsteps in 'f_start()' to catch events&#13;&#10;&#9;// during this time period&#13;&#10;&#9;function f_waitForTimeout(float p_duration) {&#13;&#10;&#9;&#9;timer t;&#13;&#10;&#9;&#9;t.start(p_duration);&#13;&#10;&#9;&#9;t.timeout;&#13;&#10;&#9;}"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_CONTROL_MODULE_NAME" value="TTCN_ControlPart"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_DECLARATIONS_MODULE_NAME" value="TTCN_Declarations"/>
    <booleanAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_ENABLED_CUSTOMIZATION" value="false"/>
    <booleanAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_ENABLED_GENERATION" value="false"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_FOLDER_NAME" value="TTCN"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TEMPLATES_MODULE_NAME" value="TTCN_Templates"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TESTCASES_ENDING_WRAPPER" value="&#9;&#9;f_end();"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TESTCASES_MODULE_NAME" value="TTCN_TestsAndControl"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TESTCASES_RECEIVING_IMPL" value="&#9;function %1%_receive( template %5% pdu ) runs on runsOn_%3% {&#13;&#10;&#9;&#9;%7%.receive( %5% );&#13;&#10;&#9;}"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TESTCASES_RECEIVING_WRAPPER" value="&#9;&#9;%7%_receive( %8% );"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TESTCASES_SENDING_IMPL" value="&#9;function %1%_send( template %5% pdu ) runs on runsOn_%3% {&#13;&#10;&#9;&#9;%7%.send( %5% );&#13;&#10;&#9;}"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TESTCASES_SENDING_WRAPPER" value="&#9;&#9;%7%_send( %8% );"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TESTCASES_STARTING_ENDING_IMPL" value="&#9;function f_start() runs on runsOn_%1% { }&#13;&#10;&#9;function f_end() runs on runsOn_%1% { }"/>
    <stringAttribute key="org.eclipse.efm.execution.core.ATTR_TTCN_TESTCASES_STARTING_WRAPPER" value="&#9;&#9;f_start();"/>
