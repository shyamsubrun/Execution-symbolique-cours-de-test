@xlia< system , 1.0 >:

timed system CoffeeMachine {
	
@composite: 
	statemachine SM {
	@public:
		type COINT_T pos_integer;
		
		port input Coin( COINT_T );
  		port output RestMon( pos_integer );
  		port output Coffee;
  	@private:
		var pos_integer PRICE;
 		var COINT_T c;	
 		var uinteger sum;
 		
		var clock urational cl;
	  		
	@region:
		state<initial> startup { 
			transition tr_0 --> idle { 
				sum = 0;
			}
		}
	    state idle {
			transition  tr_1 --> check { 
				input Coin( c );
				sum = sum + c;
				cl = 0;
			}					
		}
		state check {
			transition tr_2 --> idle {
				guard( sum < PRICE );
				tguard( cl < 4 );
				output RestMon( PRICE - sum );
				cl = 0;
			}
			transition tr_3 --> idle {
				guard( sum >= PRICE );
				tguard( cl < 4 );
				output Coffee;
				sum = 0;
				cl = 0;
			}
		}
  	}
  		
@com:
	connect< env >{
		 input SM->Coin;
  		 output SM->RestMon;
  		 output SM->Coffee;
	}

}


